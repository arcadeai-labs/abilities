{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "plugins": [
    "./node_modules/biome-plugin-no-type-assertion/no-type-assertion.grit"
  ],
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 80
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "asNeeded",
      "trailingCommas": "es5"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!**/out",
      "!**/.output",
      "!**/.tanstack",
      "!**/.turbo",
      "!**/pgdata",
      "!**/coverage",
      "!**/routeTree.gen.ts",
      "!**/pnpm-lock.yaml"
    ]
  }
}
