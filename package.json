{
  "name": "return-types-test",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:ports": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "sync": "pnpm --filter @repo/api sync",
    "typecheck": "turbo run typecheck",
    "urls": "portless list",
