  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "biome-plugin-no-type-assertion": "^1.1.1",
    "portless": "^0.15.4",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=24"
  }
}
