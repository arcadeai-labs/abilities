# Arcade + Anthropic (existing)
ARCADE_API_KEY=
ANTHROPIC_API_KEY=

# --- Auth (Better Auth BFF + OIDC). Leave unset to keep typed-in user ids. ---
# openssl rand -hex 32
BETTER_AUTH_SECRET=

# Public origin of this app (redirects + cookies). Under `pnpm dev`, portless
# injects PORTLESS_URL; set this only when that is wrong.
# BETTER_AUTH_URL=https://returntypes.localhost

# Register an OIDC client on Arcade's IdP (Ory / Coordinator). Redirect URI:
#   {BETTER_AUTH_URL}/api/auth/oauth2/callback/oidc
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_DISCOVERY_URL=https://auth.bosslevel.dev/.well-known/openid-configuration

# Optional: refuse script runs without a session once login works
# AUTH_REQUIRED=true

# Optional: comma-separated extra origins if SPA and API are not same-site
# CORS_ORIGIN=https://preview.example.com
# CROSS_SITE_COOKIES=true
