{
  "name": "@repo/backend",
  "private": true,
  "type": "module",
  "scripts": {
    "serve": "tsx --env-file-if-exists=../../.env server.ts",
    "serve:portless": "portless $(node ../../scripts/portless-name.mjs returntypes-api) --force tsx watch --env-file-if-exists=../../.env server.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.1",
    "@repo/api": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2"
  }
}
