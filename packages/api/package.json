{
  "name": "@repo/api",
  "private": true,
  "type": "module",
  "scripts": {
    "sync": "tsx --env-file-if-exists=../../.env sync.ts",
    "rpc-demo": "tsx --env-file-if-exists=../../.env src/rpc-demo.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx migrate.ts",
    "db:studio": "drizzle-kit studio",
    "test": "node --env-file-if-exists=../../.env node_modules/vitest/vitest.mjs run",
    "smoke": "tsx --env-file-if-exists=../../.env smoke.ts"
  },
  "exports": {
    ".": "./src/app.ts",
    "./client": "./src/client.ts",
    "./schema": "./src/schema.ts"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@arcadeai/arcadejs": "^2.4.1",
    "@electric-sql/pglite": "^0.5.4",
    "@hono/standard-validator": "^0.3.0",
    "@jitl/quickjs-singlefile-cjs-release-sync": "0.32.0",
    "@scalar/hono-api-reference": "^0.11.11",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.32",
    "hono-openapi": "^1.3.1",
    "quickjs-emscripten-core": "0.32.0",
    "zod": "^4.4.3"
  }
}
