{
  "name": "@repo/api",
  "private": true,
  "type": "module",
  "scripts": {
    "sync": "tsx --env-file-if-exists=../../.env sync.ts",
    "rpc-demo": "tsx --env-file-if-exists=../../.env src/rpc-demo.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env migrate.ts",
    "db:studio": "node --env-file-if-exists=../../.env ./node_modules/drizzle-kit/bin.cjs studio",
    "test": "node --env-file-if-exists=../../.env node_modules/vitest/vitest.mjs run",
    "smoke": "tsx --env-file-if-exists=../../.env smoke.ts"
  },
  "exports": {
    ".": "./src/app.ts",
    "./client": "./src/client.ts",
    "./schema": "./src/schema.ts"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.20.4",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.20",
    "@ai-sdk/mcp": "^2.0.16",
    "@arcadeai/arcadejs": "^2.4.1",
    "@electric-sql/pglite": "^0.5.4",
    "@hono/mcp": "^0.3.1",
    "@hono/standard-validator": "^0.3.0",
    "@jitl/quickjs-singlefile-cjs-release-sync": "0.32.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@scalar/hono-api-reference": "^0.11.11",
    "ai": "^7.0.37",
    "better-auth": "^1.6.25",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.32",
    "hono-openapi": "^1.3.1",
    "postgres": "^3.4.9",
    "quickjs-emscripten-core": "0.32.0",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  }
}
